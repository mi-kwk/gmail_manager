<Window x:Class="GmailManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Gmail Manager" Height="820" Width="1280" MinHeight="650" MinWidth="1000"
 Background="#F4F6FA" FontFamily="Yu Gothic UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DCE8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderBrush" Value="#D5DCE8"/></Style>
 </Window.Resources>
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Gmail Manager" FontSize="28" FontWeight="SemiBold" Foreground="#183B66"/>
   <TextBlock Text="複数アカウントの整理と、重要メールのローカル保管" Foreground="#58677C" Margin="0,4,0,16"/>
   <WrapPanel>
    <Button Content="Gmailを追加" Click="Connect_Click" x:Name="ConnectButton"/>
    <Button Content="全アカウントを同期" Click="Sync_Click" x:Name="SyncButton"/>
    <Button Content="未処理分をキャンセル" Click="Cancel_Click"/>
    <Button Content="保存フォルダー" Click="Folder_Click"/>
   </WrapPanel>
   <TextBlock Text="送信元指定の全件処理：全期間・既読未読・受信トレイ／アーカイブ済み。迷惑メール・ゴミ箱は除外。" TextWrapping="Wrap" Foreground="#58677C" Margin="0,0,0,12"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <ProgressBar x:Name="Progress" Height="6" Maximum="100"/>
   <TextBlock x:Name="Status" Text="Gmailを追加して同期してください。OAuth設定はREADMEをご確認ください。" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
   <TabItem Header="統合メール">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel>
       <Label Content="検索" VerticalAlignment="Top"/><TextBox x:Name="MailSearch" Width="250" ToolTip="件名・送信元・元アカウント" TextChanged="Filter_Changed"/>
       <ComboBox x:Name="AccountFilter" Width="260" DisplayMemberPath="Caption" SelectionChanged="AccountFilter_Changed" Margin="0,0,8,8"/>
       <Button Content="重要登録・保存" Click="Register_Click"/>
       <Button Content="選択をゴミ箱へ" Click="TrashSelected_Click"/>
       <Button Content="アーカイブ" Click="Archive_Click"/>
       <Button Content="ラベル分類" Click="Label_Click"/>
      </WrapPanel>
     </StackPanel>
     <DataGrid x:Name="MailGrid"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="送信元分析">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel><Label Content="送信元アドレス"/><TextBox x:Name="SenderInput" Width="330" ToolTip="送信元メールアドレス完全一致"/><Button Content="全アカウントの全件を確認" Click="TrashSender_Click"/></WrapPanel>
      <TextBlock Text="下の送信元を選ぶと入力欄に反映されます。件数は最後の同期時点です。" Margin="0,0,0,12"/>
     </StackPanel>
     <DataGrid x:Name="SenderGrid" SelectionChanged="Sender_Changed"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="重要メール保管庫">
    <DockPanel Margin="12">
     <WrapPanel DockPanel.Dock="Top">
      <Label Content="元アカウント"/><TextBox x:Name="VaultAccount" Width="190" ToolTip="元アカウント（表示名・メールアドレス）" TextChanged="Filter_Changed"/>
      <Label Content="送信元"/><TextBox x:Name="VaultSender" Width="190" ToolTip="送信元" TextChanged="Filter_Changed"/>
      <Label Content="件名"/><TextBox x:Name="VaultSubject" Width="190" ToolTip="件名" TextChanged="Filter_Changed"/>
      <Button Content="保存済み本文・添付を開く" Click="OpenVault_Click"/>
      <Button Content="重要解除" Click="Unregister_Click"/>
      <Button Content="保存を再試行" Click="RetryBackup_Click"/>
     </WrapPanel>
     <DataGrid x:Name="VaultGrid"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="バックアップ管理">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="重要解除後も保存済みデータは保持されます。オフライン・Gmail側削除後にも閲覧できます。" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <WrapPanel><Button Content="保存済み本文・添付を開く" Click="OpenBackup_Click"/><Button Content="保存を再試行" Click="RetryAllBackup_Click"/></WrapPanel>
     </StackPanel>
     <DataGrid x:Name="BackupGrid"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="アカウント">
    <DockPanel Margin="12">
     <WrapPanel DockPanel.Dock="Top"><Label Content="アプリ内表示名"/><TextBox x:Name="DisplayName" Width="280" ToolTip="アプリ内の表示名"/><Button Content="選択アカウントの表示名を保存" Click="Rename_Click"/></WrapPanel>
     <DataGrid x:Name="AccountsGrid"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="結果・履歴">
    <DockPanel Margin="12">
     <WrapPanel DockPanel.Dock="Top"><Button Content="選択履歴の詳細" Click="HistoryDetails_Click"/><Button Content="失敗対象だけ再試行" Click="RetryOperation_Click"/></WrapPanel>
     <DataGrid x:Name="HistoryGrid"/>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
